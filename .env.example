# Neon database connection string. Keep this server-only.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
# Copy the Auth URL and JWKS URL from Neon Console > Auth.
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-endpoint/neondb/auth/.well-known/jwks.json
# Online checkout is disabled. Only needed for legacy Stripe webhook fulfillment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Hosted calendar setup: use the exact HTTPS website origin (no trailing path).
PUBLIC_SITE_URL=https://your-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
# Only this verified Google account can authorize the calendar connection.
GOOGLE_OWNER_EMAIL=
# A random 32-byte key encoded as 64 hex characters. Keep outside the database.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Preserve this key across redeployments; changing it requires reconnecting.
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Optional legacy local helper only. Hosted bookings use the encrypted DB token.
GOOGLE_REFRESH_TOKEN=
