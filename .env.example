# Neon database connection string. Keep this server-only.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
# Copy the Auth URL and JWKS URL from Neon Console > Auth.
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth
NEON_AUTH_JWKS_URL=https://your-neon-auth-endpoint/neondb/auth/.well-known/jwks.json
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://your-domain.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
